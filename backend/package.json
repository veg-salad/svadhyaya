{
  "name": "svadhyaya-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Svadhyaya API — Emic Alignment + Scholar Brief service",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "build:lambda": "nest build && esbuild dist/lambda.js --bundle --platform=node --target=node20 --outfile=dist-lambda/lambda.js --external:@nestjs/microservices --external:@nestjs/websockets --external:@nestjs/websockets/socket-module --external:class-transformer/storage --external:@fastify/*",
    "package:lambda": "node scripts/package-lambda.mjs",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@vendia/serverless-express": "^4.12.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "jose": "^5.9.6",
    "openai": "^4.77.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/aws-lambda": "^8.10.147",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.10",
    "esbuild": "^0.24.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  }
}
